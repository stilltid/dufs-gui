// 拖拽高亮横幅
//
// 原生拖放(Rust 侧的 IDropTarget)检测到有文件悬停在窗口上时显示。
// 放在分页头下方常驻,这样不管当前在哪个分页都看得到。
//
// ★ 只在需要时由调用方 `if` 包起来实例化,关掉时不占任何高度 ——
//   组件自己带 height,如果一直存在就会在窗口里留一条空白。

import { Theme } from "../theme.slint";

export component DropBanner inherits Rectangle {
    height: 40px;
    background: Theme.accent;
    border-radius: Theme.radius;

    Text {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        text: @tr("松开鼠标即可共享拖入的文件或文件夹（一次仅支持一个）");
        color: Theme.on-accent;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
